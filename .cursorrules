## 🧪 Testing Guidelines

### Backend Testing

```dart
// Unit test example
void main() {
  group('BookingRepository', () {
    test('createBooking should return booking', () async {
      // Arrange
      final mockDb = MockDatabaseConnection();
      final repository = BookingRepositoryImpl(mockDb);
      
      // Act
      final result = await repository.createBooking(params);
      
      // Assert
      expect(result.id, isNotNull);
      expect(result.status, BookingStatus.PENDING);
    });
  });
}
```

### Frontend Testing

```dart
// Widget test example
void main() {
  testWidgets('BookingsScreen displays bookings', (tester) async {
    await tester.pumpWidget(
      ProviderScope(
        overrides: [
          bookingsProvider.overrideWithValue(AsyncValue.data(testBookings)),
        ],
        child: MaterialApp(home: BookingsScreen()),
      ),
    );
    
    expect(find.text('Booking 1'), findsOneWidget);
  });
}
```

