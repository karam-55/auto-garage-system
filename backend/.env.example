# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/garage_db

# Server Configuration
PORT=8080

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-min-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-min-32-characters

# CORS Configuration (REQUIRED for production)
CORS_ORIGIN=https://auto-garage-staff-frontend.pages.dev

# Default User Passwords (REQUIRED for initial setup)
DEFAULT_ADMIN_PASSWORD=<strong-admin-password-change-after-first-login>
DEFAULT_RECEPTIONIST_PASSWORD=<strong-receptionist-password-change-after-first-login>

# WhatsApp Configuration (Future)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
